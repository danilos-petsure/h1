  <folder name="Application" id="id-5454eec1114f46949d0fb09f2c1b8cc0" type="application">
    <element xsi:type="archimate:ApplicationComponent" name="VPMS / Tyro SDK" id="id-438a499ce47b4f7eb32e297449f2c044"/>
    <element xsi:type="archimate:ApplicationComponent" name="VetHub" id="id-d7e6683d45f0406e9031163deac92dd0"/>
    <element xsi:type="archimate:ApplicationComponent" name="COS" id="id-b44b981321a9470bb8ae756b28ea8d8a"/>
    <element xsi:type="archimate:ApplicationComponent" name="Claim Automation" id="id-049508a883b044e4a78e79f95a92efa0"/>
