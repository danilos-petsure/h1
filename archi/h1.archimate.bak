    <element xsi:type="archimate:ApplicationComponent" name="CSP.Au.DigitalApi (DAPI)" id="id-33cfd8b12bdc4243a6799ac952b91c3d"/>
    <element xsi:type="archimate:ApplicationComponent" name="Dynamic Clapi" id="id-d96d0d881a85486a946f8bcebfbd3392"/>
    <element xsi:type="archimate:ApplicationComponent" name="STP - Clawdia" id="id-8a89555aeaaa4a77a4e4d5c67eb39a84"/>
    <element xsi:type="archimate:ApplicationComponent" name="UPM Db" id="id-0e37e6c143ee49cd90807b79471116e2"/>
    <element xsi:type="archimate:ApplicationComponent" name="UPM Dynamics API" id="id-a3d02518353947c890f07ef93d1e779e"/>
    <element xsi:type="archimate:ApplicationComponent" name="ML Environment" id="id-b6d4dd148e7941e3a31b65883613c4a6"/>
    <element xsi:type="archimate:ApplicationComponent" name="UPM+" id="id-f21a15c743204cb6b4f5cdefd7a617cb"/>
    <element xsi:type="archimate:ApplicationFunction" name="Submit Medical Record Claim" id="id-69fa2d5350644a0082f521eb2a53256f"/>
    <element xsi:type="archimate:ApplicationService" name="Get Conversation ID" id="id-e5213401bb75492d918d90b56d0e9329">
      <documentation>The vet software asks for a new conversation ID to start a claim. The insurer ID is optional and is rejected with 400 if invalid.</documentation>
      <property key="code" value="GetConversationID (ClaimsController.cs:55)"/>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Recognise Claim Type" id="id-f292b2a615304e5c8d113078ef3f9ce8"/>
    <element xsi:type="archimate:ApplicationFunction" name="Eligibility Check" id="id-7a80d908864941b4af296568a63725e3"/>
    <element xsi:type="archimate:ApplicationFunction" name="Invoice Generation" id="id-cd747434c01f42a5ad6f2a93d3d68ac2"/>
    <element xsi:type="archimate:ApplicationService" name="Poll Conversations in COS" id="id-f7f4e9787ab24be6b2cc475aefc46922">
      <documentation>Not a REST service. It is the COS.Poll.Services.VetHub Windows service, which runs on a timer. For each configured insurer it calls VetHub GET api/claim/newconversations?claimType={0}&amp;NumberofClaims={1} (app setting VetHubNewConversationsAddress, VetHubService.cs:27) and starts the claim saga.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Enrich Claim with Reference Number" id="id-ed320fbc6fe145718f7e0e1298315822"/>
    <element xsi:type="archimate:ApplicationFunction" name="Policy Validation" id="id-ec0201ec72f1433d9eb70bfa736ea07e"/>
    <element xsi:type="archimate:ApplicationFunction" name="Enrich Claim with Treatment Codes" id="id-1d98d401ee9042b8b76a1e36938def0f"/>
    <element xsi:type="archimate:ApplicationService" name="Submit Claim" id="id-50b5567c8dd14e38a120ac5881bdc62b">
      <documentation>Maps the COS claim to the insurer's format and sends it to the right back-end. UPM+ AU, NZ and TPN go to DAPI api/Claims/Submit; Vet Partners goes to Boomi.</documentation>
      <property key="code" value="SubmitClaim (ClaimsController.cs:587)"/>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="DAPI Routing logic" id="id-4edcc5bbceca4b84ab2edeb5e5d008bf">
      <documentation>Routing: AuthorisationHandler.cs returns 400 if the InsuranceProviderId header is missing and 401 if the insurer is not in AllowedInsurers. AuthenticationHandler.cs and TokenService.cs get a DAPI token per insurer (api/Customer/Authentication) and cache it for 5 minutes; Vet Partners uses Basic auth instead. BackendAdapter.cs:42 picks the HTTP client named after the insurer ID; InsurersClientRegistration.cs:40-52 builds one client per insurer with its own base URL, retry, timeout and circuit breaker. Vet Partners alone is handled by VetPartnersBackendAdapter (IocConfig.cs:31, PostClaimsManager.cs:36).</documentation>
      <property key="config" value="appsettings.prod.json: AU -> https://api.petsure.com.au/, TPN -> https://tp-api.petsure.com.au; NZ and VP CLAPI instances have their own single-insurer settings files"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Submit Claim" id="id-8a03037a0c834846b35aa75dc46d62c7">
      <documentation>Writes the claim into the UPM DS_* staging tables. Source: CLAPI config SubmitClaimEndPoint; the DAPI code itself is not verified.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Prepare DS Tables for Claim" id="id-5495505a8b1e491d8dce95b471724c4c"/>
    <element xsi:type="archimate:DataObject" name="DS* Tables" id="id-d97895347e084b83b236ed5748caf12b"/>
    <element xsi:type="archimate:ApplicationService" name="UPM Data Polling (10 min)" id="id-b7ace849a6d34230959adba7e1e8c9f2">
      <documentation>Not verified (UPM repo not accessible). Looks like a UPM job, not an API; consider moving it to the UPM+ functions lane as DS Claims ingestion job.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Ingest Claim from Data" id="id-3fb8828b34df47249e5235848e6ebb25"/>
    <element xsi:type="archimate:ApplicationService" name="Finish Submit Claim" id="id-14942a5be3a046e0bc5357e7dd9657d3">
      <documentation>Marks the hand-off to the UPM DS_Claims table as complete after the last attachment.</documentation>
      <property key="code" value="FinishSubmitClaim (ClaimsController.cs:956)"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Finish Submit Claim" id="id-642594984da14ab69b166add420179f0">
      <documentation>CLAPI calls it with PUT (BackendAdapter.cs:1180).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Update DS Tables for Claim" id="id-65e8715779c54f53b012a0bfdecb968e"/>
    <element xsi:type="archimate:ApplicationService" name="Lodge" id="id-06f0a5e1091a4d319a3a927d8b82d3d8">
      <documentation>Called by COS after Finish Submit Claim to make UPM create the claim from DS_Claims straight away. Requires the InsuranceProviderId header; Basic auth.</documentation>
      <property key="code" value="Lodge (ClaimsController.cs:39)"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Lodge Claim" id="id-0346d578164041698978716ed528a310">
      <documentation>Lodge endpoint (from Confluence; the code reads it from GitHub variables). AU base: upmprod.internal.petsure.com.au:9248/PETSURE_UPM_API_BASIC. TPN base: tpupm.internal.petsure.com.au:9148/TRUPANION_PROD_API_BASIC.</documentation>
      <property key="AU base" value="upmprod.internal.petsure.com.au:9248/PETSURE_UPM_API_BASIC"/>
      <property key="TPN base" value="tpupm.internal.petsure.com.au:9148/TRUPANION_PROD_API_BASIC"/>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="UPM Routing Logic" id="id-f982a4ecd77a40569189e6c732f594d5">
      <documentation>Routing: at startup the app reads CONFIGURED_INSURERS and loads a DYNAMIC_LODGE_API_{AU|TPN} block for each, each with its own HTTP client (Program.cs:78-86, 189-205). DynamicAPIAdapter.ClaimLodgeAsync (:48-57) matches the header against INSURER_CODE and sends PUT + If-Match: * to that insurer's CLAIM_LODGE_ENDPOINT. DynamicApiLodgeHttpHandler.cs adds that insurer's Basic credentials from Key Vault (DYNAMIC-API-USERNAME for AU, TPN-DYNAMIC-API-USERNAME for TPN). URLs come from GitHub variables (DYNAMIC_LODGE_API_TPN_BASE_URI and others).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Duplicate Check" id="id-45f53c0ae42f4e9194a2cf1707752d74"/>
    <element xsi:type="archimate:ApplicationFunction" name="Fraud Check" id="id-622655f97d3d43d9aae658f4ae18e0d7"/>
    <element xsi:type="archimate:ApplicationFunction" name="Bank Details Check" id="id-ff788ae004554cb589932db405e44bdd"/>
    <element xsi:type="archimate:ApplicationFunction" name="Request Medical Assessment" id="id-efef399f119c4337b2e4b7640158c34c"/>
    <element xsi:type="archimate:ApplicationService" name="Claw Init" id="id-3fb14a5daff24cbf9bc256556f955f49">
      <documentation>UPM calls it with Basic auth to start the straight-through process. It forwards the claim to Clawdia's CLAW-INIT-API, authenticating with managed identity (ClawAPIAdapter.cs:28-36).</documentation>
      <property key="code" value="ClawInit"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Write Claim" id="id-28c72003ad9347d69ab68b47947f8a1f">
      <documentation>Clawdia writes the assessed claim to UPM (Entra ID scope Claims.ReadWrite). It checks the checksum and whether the claim is assigned to CLAWDIA.</documentation>
      <property key="code" value="WriteClaim"/>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Call UPM AU Write" id="id-220e044c6ec147daa2cbdc2ad902ddbf">
      <documentation>Not routing: always uses the single DYNAMIC_API client with the CLAWDIA credentials (DynamicAPIAdapter.cs:36,114-116, DynamicApiHttpHandler.cs:26-32), so it only reaches UPM AU.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Write" id="id-7b77a94f7e224e9c812dd987d71c834c">
      <documentation>UPM claim write endpoint, AU only. Base: upmprod-capi.internal.petsure.com.au:9248.</documentation>
      <property key="base" value="upmprod-capi.internal.petsure.com.au:9248"/>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Benefit Calculation" id="id-4d387b9612014db8bd5a4ab6a88856ce"/>
    <element xsi:type="archimate:ApplicationFunction" name="Payment Settlement" id="id-4c1c1ff275c643a88f303e5e11ec749e"/>
    <element xsi:type="archimate:ApplicationService" name="GapOnly Benefit" id="id-d47e911bc0ca4e5a8dff645b4e6c35cb">
      <documentation>UPM pushes the assessed gap benefit, which is forwarded to COS.</documentation>
      <property key="code" value="Benefit"/>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Forward to COS AUS" id="id-fd49f83969ac48ff8833cc512d6a1c97">
      <documentation>Not routing: always uses the single COS_API client, base URL LZ_AU_COS_API_BASE_URI (CosAPIAdapter.cs:26-39). It only reaches COS AUS, which also serves TPN.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Gap Only Benefit" id="id-2322c36a6d0e44b6b800a66019e0f927">
      <documentation>Receives the gap benefit from UPM via Dynamic CLAPI (claim ref and claim number, status, benefit paid, logical claims). It checks the benefit against the amount paid, saves it in COS and passes it on to VetHub. Dynamic CLAPI sends exactly this payload (GapOnlyBenefitModel, CosAPIAdapter.cs:29-39). The api/GapOnly/GapOnlyBenefit route is the cut-down one for third-party insurers (Vet Partners).</documentation>
      <property key="code" value="GapOnlyController.Benefit"/>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Prepare Benefit Req. for VetHub" id="id-f9b9df7c39484fea99db29b7ed684acd"/>
    <element xsi:type="archimate:ApplicationService" name="Update Gap Benefit Amount" id="id-60f90ed9086a4856b8df576a46a13662">
      <documentation>The insurer side (COS) posts the GapOnly benefit amount for a claim. Only authorised insurance providers can call it.</documentation>
      <property key="code" value="UpdateGapBenefitAmount (ClaimsController.cs:651)"/>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Update Benefit on Claim" id="id-26da0549fda8479e9d212a7595fb6da2">
      <documentation>Routing: decides where the outcome goes based on the practice's vet software (VpmsName). Tyro: sends the outcome to the Tyro webhook unless it was already sent (then returns 409); the Tyro response is saved (UpdateGapBenefit.cs:139-191). EzyVet with the request's UpdateVPMS flag true: sends it to EzyVet (PassGapOnlyToEzyVetAsync, UpdateGapBenefit.cs:246-250). All other vet software: nothing is sent; the outcome is only stored and the vet software collects it by polling VetHub.</documentation>
      <property key="config" value="Tyro:* settings in environments/prod.json"/>
    </element>
    <element xsi:type="archimate:DataObject" name="Vet Hub Conversation" id="id-74567b3e221949e1b51c9ddfc8b3d9c9"/>
    <element xsi:type="archimate:ApplicationService" name="Tyro adjudicateClaim webhook" id="id-2702c20605ab40db814042897a0e5179">
      <documentation>Tyro's webhook that receives the GapOnly outcome from VetHub. VetHub calls it with an OAuth token from auth.tyrohealth.com. Config key Tyro:TyroGapOnlyOutcomeEndpoint. Called from ExternalVetPracticeManager.cs:87.</documentation>
      <property key="config" value="Tyro:TyroGapOnlyOutcomeEndpoint"/>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Communication outcome polling" id="id-665116df580c4f8483f676419c983697"/>
    <element xsi:type="archimate:ApplicationService" name="CLAW-INIT-API" id="id-50c8da9984a44d549bcf98c2063eea67">
      <documentation>KeyVault Function App. Checks the claim, reads the CLAW on/off and audit-mode switches from Key Vault, and publishes a CloudEvent that starts the matching entry workflow. Routes by claim type (CosService.CheckCLAWConfigurations, :150-215): CSP -> PetSure.CLAW.EClaimCSP; VetHub eClaim -> EClaimVH; GapOnly (PayToServiceProvider = 1) -> GapOnly; other -> EClaimOther. If CLAW is off it returns CLAWOFF without publishing.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Easy Cohort" id="id-ca4549c663114272ac495a590ed35c87"/>
    <element xsi:type="archimate:ApplicationFunction" name="Calll GP Model" id="id-9b1e5dbc54ab4b099a3224d8f08759e5"/>
    <element xsi:type="archimate:ApplicationFunction" name="Apply BR to Prediction" id="id-cb07247bc39c47d8bd8dd57648e5e50d"/>
    <element xsi:type="archimate:ApplicationFunction" name="Prepare Write Request for UPM" id="id-fe378ee6467848a7b91ebe338b82c069"/>
    <element xsi:type="archimate:ApplicationService" name="Submit Attachment" id="id-22cf7e48bcbb4b4986c025a604fb4ebf">
      <documentation>Uploads one attachment file to a claim. An attachment ID must first be requested with GET /api/Claim/{conversationId}/Attachment/NewConversationId.</documentation>
      <property key="code" value="SubmitAttachment (ClaimsController.cs:136)"/>
    </element>
    <element xsi:type="archimate:DataObject" name="COS Claim" id="id-76a703f5beaa4b758be46bb6086262da"/>
    <element xsi:type="archimate:ApplicationService" name="predict Treatment Code" id="id-526b76871de94cceb12e07c7cf47d9c7">
      <documentation>Not called over REST. COS ClaimsAutomationIntegration publishes the Event Grid event Petsure.ClaimsAutomation.Claim to topic ps-prod-egt-claimsautoclaims, which triggers the Logic App. The result comes back via POST api-cos-prod/api/Claims/ClaimsAutomation/Completed. The Logic App's own trigger name is not verified.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Save new Conversation" id="id-ddfab035d5ae4191b24bd8c8eda92f12"/>
    <element xsi:type="archimate:DataObject" name="Vet Hub Conversation" id="id-bd78a8108ad3465b8504b1f75d2ed77d"/>
    <element xsi:type="archimate:ApplicationService" name="Submit Claim" id="id-1223548d986b47f1ab65b523b0808035">
      <documentation>The vet software submits the claim as VetXML (default) or JSON. It checks required sections, GapOnly service hours, public holidays and whether the practice can do GapOnly claims. Returns 201.</documentation>
      <property key="code" value="SubmitClaim (ClaimsController.cs:202)"/>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Save COS Claim" id="id-ce2bea17e6be4acaa7cf84c45f3b294b"/>
    <element xsi:type="archimate:ApplicationFunction" name="Convert to T*" id="id-897befb76afb401cb3851f3d015b8f37"/>
    <element xsi:type="archimate:ApplicationService" name="Sophia Junior api" id="id-427cc8d92d004af7b5e80a1dd4e4cfa5">
      <documentation>Not verified (the Claims Automation and ML repos were not accessible).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Sophia Junior Model" id="id-9cbbeb19a25f41618d48bd2e1de1193a"/>
    <element xsi:type="archimate:ApplicationFunction" name="Apply Business Rules" id="id-2f01f19603e240759b2da8f56ff85805"/>
    <element xsi:type="archimate:ApplicationFunction" name="Publish to Cos" id="id-4f88a1c9ae9e4a0f8326528443782d2d"/>
    <element xsi:type="archimate:ApplicationService" name="GP Model Endpoint" id="id-aff032b67d2943e99aa7fc425a64c287">
      <documentation>Managed online endpoint ps-prd-claimsauto-gp, deployment gp-prod-deployment, workspace ps-prd-ml-ws-claimsauto, in the legacy subscription 60181c42... (ClawGP/settings.toml:132-139). Called by Clawdia's GetGPModelOutput function using app setting GP_MODEL_PREDICTION_API_URL and bearer token GP-MODEL-PREDICTION-API-TOKEN. Two models sit behind the endpoint: the GP model (sleepy_king-14.pt) and a multiple-diagnosis model (musing_onion_md.pkl). The /score path is the standard Azure ML path, not confirmed in config.</documentation>
      <property key="endpoint" value="ps-prd-claimsauto-gp"/>
      <property key="deployment" value="gp-prod-deployment"/>
      <property key="workspace" value="ps-prd-ml-ws-claimsauto"/>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="GP Model" id="id-cc7880452cc945cc9bd7d8f15269db0d"/>
    <element xsi:type="archimate:ApplicationFunction" name="Case Linking" id="id-a620633571f7433d9c1f0f049b511c40">
      <documentation>Not found in the GP model code; it may live elsewhere or be planned. To be confirmed.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Lodge Claim in UPM" id="id-29a7f0133d5c47e8acf5fa4afc9aa093"/>
    <element xsi:type="archimate:ApplicationFunction" name="Load Claim Data" id="id-7b2b6d01df3548ebb6f83cf1e99281ba"/>
    <element xsi:type="archimate:ApplicationFunction" name="Load Policy Data" id="id-0fc8713252ea487ba98f5f0a75608183"/>
    <element xsi:type="archimate:ApplicationFunction" name="Map Data into Logic Claims" id="id-612759115fd849f2906c8dcaf4444827"/>
    <element xsi:type="archimate:ApplicationService" name="Submit Claim Attachment" id="id-a863f5a0bbf84dc7950bf38224bedb9e">
      <documentation>COS calls it between Submit Claim and Finish Submit Claim; forwards the attachment to DAPI api/Claims/SubmitDocument.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Submit Document" id="id-816cf20e952648e4a37fc6e350a1ec09">
      <documentation>Receives claim attachments forwarded by CLAPI Submit Claim Attachment.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="File Conent in Windows File Share" id="id-82f03d2674514667a0864009aae290c8">
      <documentation>The folder comes from the DestinationClaimFilePath setting. At deploy time it’s read from a Key Vault secret: the secret name is in GitHub variable CLAIM_DES_PATH and the vault in CSP_KEYVAULT. The actual paths aren’t in the repo; Confluence and the infrastructure document give them as:

AU: \\PS-BCS-PRD-API1\auapidocuments
TPN: \\PS-BCS-PRD-API1\PRD_TP_UPMClaimDoc</documentation>
    </element>
