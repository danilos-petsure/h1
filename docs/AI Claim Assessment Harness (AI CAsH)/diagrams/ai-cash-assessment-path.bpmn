<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_AICASH" targetNamespace="http://petsure.com.au/bpmn/ai-cash" exporter="Camunda Modeler" exporterVersion="5.48.0">
  <bpmn:process id="AI_CAsH_Assessment" name="AI CAsH — medical assessment path (end of Tier 3)" isExecutable="false">
    <bpmn:startEvent id="Start" name="Claim context enriched">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="T_Ensemble" name="Predict Diagnose and Case Linking (ML)">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_Confident" name="Ensemble confident?">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_STP" name="Assessment ready (STP)">
      <bpmn:incoming>f3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="G_Assessor" name="Assessor input needed?">
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
      <bpmn:outgoing>f14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="U_QuickFix" name="Quick fix bay: assessor confirms and answers">
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:outgoing>f15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_Merge">
      <bpmn:incoming>f14</bpmn:incoming>
      <bpmn:incoming>Flow_16bgmi2</bpmn:incoming>
      <bpmn:outgoing>f16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_Predict" name="Predict diagnosis from questions and answers (ML)">
      <bpmn:incoming>f16</bpmn:incoming>
      <bpmn:outgoing>f17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_LowConf" name="Diagnosis confidence low?">
      <bpmn:incoming>f17</bpmn:incoming>
      <bpmn:outgoing>f18</bpmn:outgoing>
      <bpmn:outgoing>f19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="U_Manual" name="AI-assisted manual medical assessment">
      <bpmn:incoming>f18</bpmn:incoming>
      <bpmn:outgoing>f20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Harness" name="Assessment ready (harness)">
      <bpmn:incoming>f19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Manual" name="Assessment ready (assessor)">
      <bpmn:incoming>f20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="Start" targetRef="T_Ensemble" />
    <bpmn:sequenceFlow id="f2" sourceRef="T_Ensemble" targetRef="G_Confident" />
    <bpmn:sequenceFlow id="f3" name="yes" sourceRef="G_Confident" targetRef="End_STP" />
    <bpmn:sequenceFlow id="f13" name="yes" sourceRef="G_Assessor" targetRef="U_QuickFix" />
    <bpmn:sequenceFlow id="f14" name="no" sourceRef="G_Assessor" targetRef="G_Merge" />
    <bpmn:sequenceFlow id="f15" sourceRef="U_QuickFix" targetRef="Gateway_1exwbyn" />
    <bpmn:sequenceFlow id="f16" sourceRef="G_Merge" targetRef="T_Predict" />
    <bpmn:sequenceFlow id="f17" sourceRef="T_Predict" targetRef="G_LowConf" />
    <bpmn:sequenceFlow id="f18" name="yes" sourceRef="G_LowConf" targetRef="U_Manual" />
    <bpmn:sequenceFlow id="f19" name="no" sourceRef="G_LowConf" targetRef="End_Harness" />
    <bpmn:sequenceFlow id="f20" sourceRef="U_Manual" targetRef="End_Manual" />
    <bpmn:exclusiveGateway id="Gateway_1exwbyn" name="Assessor Perform Manual Assessment Instead?">
      <bpmn:incoming>f15</bpmn:incoming>
      <bpmn:outgoing>Flow_16bgmi2</bpmn:outgoing>
      <bpmn:outgoing>Flow_119bmov</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_16bgmi2" name="no" sourceRef="Gateway_1exwbyn" targetRef="G_Merge" />
    <bpmn:endEvent id="Event_1edm53c" name="">
      <bpmn:incoming>Flow_119bmov</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_119bmov" name="yes" sourceRef="Gateway_1exwbyn" targetRef="Event_1edm53c" />
    <bpmn:sequenceFlow id="f4" name="no" sourceRef="G_Confident" targetRef="T_Questions" />
    <bpmn:serviceTask id="T_Questions" name="Retrieve questions for candidate diagnosis families">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="P_Join">
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="f12" sourceRef="P_Join" targetRef="G_Assessor" />
    <bpmn:serviceTask id="T_Agent" name="Answer via AI agent (claim context + questions)">
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f11" sourceRef="T_Agent" targetRef="P_Join" />
    <bpmn:serviceTask id="T_ML" name="Answer via ML">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f10" sourceRef="T_ML" targetRef="P_Join" />
    <bpmn:serviceTask id="T_SQL" name="Answer via SQL">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f9" sourceRef="T_SQL" targetRef="P_Join" />
    <bpmn:parallelGateway id="P_Split">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
      <bpmn:outgoing>f7</bpmn:outgoing>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="f8" sourceRef="P_Split" targetRef="T_Agent" />
    <bpmn:sequenceFlow id="f7" sourceRef="P_Split" targetRef="T_ML" />
    <bpmn:sequenceFlow id="f6" sourceRef="P_Split" targetRef="T_SQL" />
    <bpmn:sequenceFlow id="f5" sourceRef="T_Questions" targetRef="P_Split" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="AI_CAsH_Assessment">
